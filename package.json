{
  "name": "pi-subagents-wj",
  "version": "0.1.0",
  "description": "Pi 子代理扩展包",
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["dist", "extensions", "src"],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "semver": "7.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "24.12.4",
    "@types/semver": "7.7.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:bridge": "tsc -p tsconfig.bridge.json",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "prepack": "npm run build:bridge",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["./extensions/pi-subagents-wj.ts"]
  },
  "piSubagent": {
    "requiresPi": ">=0.84.1"
  }
}

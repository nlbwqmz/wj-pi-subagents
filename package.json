{
  "name": "pi-subagent",
  "version": "0.1.0",
  "description": "Pi 子代理扩展包",
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["extensions", "src"],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "semver": "7.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/semver": "7.7.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["./extensions/pi-subagent.ts"]
  },
  "piSubagent": {
    "requiresPi": ">=0.83.0"
  }
}

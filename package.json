{
  "name": "wj-pi-subagents",
  "version": "0.3.3",
  "author": "WJ",
  "description": "Multi-level subagent orchestration plugin for Pi — no built-in templates, no preset workflows, everything is yours to shape",
  "homepage": "https://github.com/nlbwqmz/wj-pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/nlbwqmz/wj-pi-subagents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nlbwqmz/wj-pi-subagents.git"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "multi-agent",
    "ai-agents",
    "pi-extensions"
  ],
  "files": [
    "LICENSE",
    "dist",
    "index.ts",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "@earendil-works/pi-tui": ">=0.84.4"
  },
  "dependencies": {
    "semver": "7.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "24.12.4",
    "@types/semver": "7.7.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:bridge": "node scripts/build-bridge.mjs",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "release:validate": "node scripts/validate-release-tag.mjs",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build:bridge",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:bridge",
    "test": "node --experimental-strip-types --test-reporter=dot --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "compat:pi": "node scripts/pi-compat-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "wjPiSubagents": {
    "requiresPi": ">=0.84.4"
  }
}
